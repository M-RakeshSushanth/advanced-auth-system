{
  "info": {
    "_postman_id": "a981c201-1b2c-4f81-8b01-a1b2c3d4e5f6",
    "name": "Advanced Authentication and Authorization System API",
    "description": "Comprehensive Postman collection for testing the Modular Monolithic Authentication and Authorization Backend (Node.js, Express, TypeScript, MongoDB, JWT, Google OAuth 2.0, 2FA/TOTP, RBAC).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "temp2FAToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "verificationToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
